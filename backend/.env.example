# 后端本地覆盖配置（可选，不提交敏感内容）
# 用法：复制为 backend/.env 后按需修改；对应 backend/app/config.py 的 Settings（环境变量前缀 APP_）
# 优先级：环境变量 APP_xxx > .env 文件 > config.py 里的默认值

# ---------- 基础信息：会被 GET /api/health 返回给前端展示 ----------
# 运行环境标识：development=开发 / production=生产
APP_ENV=development
# 监听网卡地址：默认只绑回环地址，保证后端端口不对局域网暴露
APP_HOST=127.0.0.1
# 监听端口：需与 frontend/src/config/index.ts 的 API_PORT、Electron 主进程保持一致
APP_PORT=8000

# ---------- DeepSeek 对话模型（chat）：Agent 对话用的密钥 ----------
# 对话模型 API 密钥；留空则 Agent 无法启动（示例值请勿当真实 key 使用）
APP_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
