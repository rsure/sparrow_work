{
  "name": "app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vue3 + TypeScript + Vue Router 前端（同时作为 Electron 渲染进程页面）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "vant": "^4.10.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
