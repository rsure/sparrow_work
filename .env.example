# 项目配置文件（复制为 .env 后按需修改；.env 不会提交到 git）
# 说明：这是「一页看清所有可配项」的总览文件。真正的读取方有三处，见下面各分节标题。
# 注意：Electron 主进程不会自动读取本文件；这里的变量需要在启动它的终端里 export，
#       或者写进 backend.config.json。本文件主要作为配置项说明书。

# ---------- 后端（Java 与 Python 共用一组基础变量） ----------
# 运行环境标识：development=开发 / production=生产，会影响日志与错误详情是否暴露
APP_ENV=development
# 后端监听网卡地址：127.0.0.1 只允许本机访问，不会暴露到局域网
APP_HOST=127.0.0.1
# 后端监听端口：需与下面 VITE_BACKEND_PROXY、Electron 主进程使用的端口一致
APP_PORT=8000
# 应用名：后端启动日志与接口返回中展示的项目名
# Python 默认 vue3-electron-fastapi；Java 未设置时默认 vue3-electron-fastapi-java
APP_APP_NAME=vue3-electron-fastapi
# 应用版本号：仅用于展示，与 package.json 的 version 无自动同步关系
APP_VERSION=0.1.0
# Java 后端业务数据库路径（SQLite 文件）；默认 app.db
# APP_DB_PATH=app.db
# Java 后端 LangGraph4j 检查点数据库路径；默认与业务库共用 app.db
# APP_CHECKPOINT_DB_PATH=app.db

# ---------- 前端（读取方：frontend/.env，Vite 只暴露 VITE_ 前缀的变量） ----------
# 留空：dev 走 vite 代理 /api；Electron 打包后直连 http://127.0.0.1:8000
VITE_API_BASE_URL=
# 开发态 Vite 代理的转发目标：浏览器请求 /api/* 时由 Vite 转发到这个后端地址
VITE_BACKEND_PROXY=http://127.0.0.1:8000

# ---------- Electron 主进程（读取方：electron/src/shared/backend-config.ts） ----------
# 后端目标：java=Spring Boot（默认） / python=FastAPI
# 优先级：本变量 > backend.config.json 的 target；默认 java
# APP_BACKEND_TARGET=java
# 覆盖后端端口（需同时改上面的 APP_PORT）
# APP_PORT=8000

# Java 后端自定义启动命令（默认用 backend_java/mvnw 启动 spring-boot:run）
# JAVA_BACKEND_CMD=
# 打包态指定 jar 路径（优先于 resources/backend/backend-java.jar）
# JAVA_BACKEND_JAR=
# 指定运行 jar 的 java 可执行文件（例如某个 JDK 17 的 bin/java.exe）
# JAVA_BACKEND_JAVA=

# Python 后端自定义启动命令（默认：uv run python run.py --port <APP_PORT>）
# PYTHON_BACKEND_CMD=
# 指定打包好的 Python 后端可执行文件路径（优先于 resources/backend）
# PYTHON_BACKEND_EXE=

# 渲染进程远程调试端口（排查用）
# ELECTRON_DEBUG_PORT=9222

# ---------- 安装 / 打包（pnpm 需要能下载 Electron 运行时） ----------
# 国内网络下 Electron 运行时下载镜像（下载慢或失败时取消注释）
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
# electron-builder 附带二进制（nsis、winCodeSign 等）的下载镜像
# ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
